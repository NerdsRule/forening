@if (AppUserDepartment != null)
{    
    <EditForm Model="@AppUserDepartment" OnValidSubmit="@HandleUpdateRoleAsync">
        <div class="row rounded rounded-1 my-1 p-2 border border-1 border-secondary">
            <div class="col-12 col-md-2">
                <strong>Department:</strong>
            </div>
            <div class="col-12 col-md-3">
                @AppUserDepartment.Department?.Name
            </div>
            <div class="col-12 col-md-1">
                <strong>Role:</strong>
            </div>
            <div class="col-12 col-md-3">
                @foreach (var role in RoleHelper.GetDepartmentRoles().Where(r => r != Shared.RolesEnum.None))
                {
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               id="@($"dept-role-{AppUserDepartment.Id}-{role}")"
                               checked="@IsRoleSelected(role)"
                               @onchange="args => OnRoleChanged(role, args.Value)" />
                        <label class="form-check-label" for="@($"dept-role-{AppUserDepartment.Id}-{role}")">@role</label>
                    </div>
                }
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary btn-sm">Update</button>
            </div>
            <div class="col-12 col-md-1">
                <button type="button" class="btn btn-danger btn-sm" @onclick="HandleDeleteAsync">Delete</button>
            </div>
        </div>
    </EditForm>
    <FormResultComponent @ref="_updateResult" />
    
}