
<AuthorizeView>
    <Authorized>
        <span style="color: white;">@UiStateService.User?.DisplayName</span>
        <span style="color: white;">&nbsp;- Points earned: @(UiStateService.User?.TotalPointsAwarded ?? 0)</span>
        <span style="color: white;">&nbsp;: available: @(UiStateService.User?.PointsBalance ?? 0)</span>
        <button class="nav-link btn btn-link" @onclick="BeginLogOut">Log out</button>
        <button class="ms-2 btn btn-sm btn-success oi oi-person" @onclick="MyProfileClick" title="My profile"></button>
    </Authorized>
    <NotAuthorized>
        
    </NotAuthorized>
</AuthorizeView>
