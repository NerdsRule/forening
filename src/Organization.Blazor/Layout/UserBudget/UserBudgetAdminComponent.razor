<div class="card mt-2">
    <div class="card-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="card-title fs-6 d-block d-md-none fw-bold">User Budgets</span>
                <span class="card-title fs-4 d-none d-md-block fw-bold">User Budgets</span>
                @if (_isLoadingBudgets)
                {
                    <div class="spinner-border spinner-border-sm text-secondary" role="status" aria-label="Loading budgets"></div>
                }
            </div>
            <div class="text-end">
                <div class="small text-muted">Filtered totals</div>
                <div class="fw-bold">Budget: @GetFilteredBudgetDisplay()</div>
                <div class="fw-bold">Used: @GetFilteredUsedDisplay()</div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label" for="userBudgetUserFilter">User</label>
                <input id="userBudgetUserFilter"
                       class="form-control"
                       placeholder="Search by name or username"
                       @bind="_userFilterText"
                       @bind:event="oninput" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="userBudgetTagFilter">Tag</label>
                <InlineAutocompleteDropdown TItem="string"
                                            Id="userBudgetTagFilter"
                                            Items="_existingTags"
                                            ItemTextSelector="(item => item)"
                                            Value="@_tagFilterText"
                                            ValueChanged="OnTagFilterChanged"
                                            OnItemSelected="OnTagFilterSelected"
                                            Placeholder="Filter by tag" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="userBudgetDescriptionFilter">Description</label>
                <InlineAutocompleteDropdown TItem="string"
                                            Id="userBudgetDescriptionFilter"
                                            Items="_descriptionSuggestions"
                                            ItemTextSelector="(item => item)"
                                            Value="@_descriptionFilterText"
                                            ValueChanged="OnDescriptionFilterChanged"
                                            OnItemSelected="OnDescriptionFilterSelected"
                                            Placeholder="Filter by description" />
            </div>
        </div>

        @if (GetVisibleUsers().Count == 0)
        {
            <div class="text-muted">No users available.</div>
        }
        else
        {
            @foreach (var user in GetVisibleUsers())
            {
                <MyBudgetComponent Title="@GetUserDisplayText(user)"
                                   UserId="@user.Id"
                                   CanEdit="true"
                                   Collapsed="true"
                                   FilterTag="@_tagFilterText"
                                   FilterDescription="@_descriptionFilterText"
                                   SummaryChanged="OnUserSummaryChanged"
                                   VisibilityChanged="OnUserVisibilityChanged"
                                   LoadingChanged="OnUserLoadingChanged" />
            }
        }
    </div>
</div>